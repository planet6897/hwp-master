{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extract summary.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "sha256",
    "extractedAt",
    "info",
    "counts",
    "untrustedContent",
    "injectionSignals",
    "files",
    "dir"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "source": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extractedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "info": {
      "type": "object"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "untrustedContent": {
      "const": true
    },
    "injectionSignals": {
      "type": "array"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dir": {
      "type": "string"
    }
  }
}
