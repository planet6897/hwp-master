{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extract kv.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "untrustedContent",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "source": {
      "type": "string"
    },
    "untrustedContent": {
      "const": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "keyNorm",
          "value",
          "source",
          "index"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "keyNorm": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source": {
            "enum": [
              "field",
              "table",
              "paragraph"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "duplicateOf": {
            "type": "integer",
            "minimum": 0
          },
          "blockId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
