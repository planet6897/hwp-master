{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extract pages.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "untrustedContent",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "source": {
      "type": "string"
    },
    "untrustedContent": {
      "const": true
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ]
      }
    }
  }
}
