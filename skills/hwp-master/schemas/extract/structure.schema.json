{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extract structure.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "untrustedContent",
    "structure"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "source": {
      "type": "string"
    },
    "untrustedContent": {
      "const": true
    },
    "structure": {
      "type": [
        "object",
        "array"
      ]
    }
  }
}
