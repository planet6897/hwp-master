{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extract outline.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "untrustedContent",
    "outline"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "source": {
      "type": "string"
    },
    "untrustedContent": {
      "const": true
    },
    "outline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "level",
        "text",
        "page",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s\\d+\\.p\\d+"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 0
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
